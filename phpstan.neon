# Analisis estatico (PHPStan): composer static  (o php vendor/bin/phpstan analyse)
#
# Linea base: phpstan-baseline.neon guarda solo 3 avisos que PHPStan no puede
# entender (una referencia & que crea la posicion con null, la propiedad de
# una clase anonima en un test y el test de la plantilla de Yii en common/).
# Todo lo demas se resolvio anotando tipos (2026-11-15): un aviso nuevo se
# corrige, no se agrega a la linea base. Si se corrige uno de los 3, regenerarla:
#   php vendor/bin/phpstan analyse --generate-baseline phpstan-baseline.neon
# No se analiza frontend/ (sitio publico de la plantilla, no se usa).

includes:
    - phpstan-baseline.neon

parameters:
    level: 5

    # Version de PHP del servidor de pruebas de la DTIC (2026-11-02).
    phpVersion: 80300

    paths:
        - backend/assets
        - backend/components
        - backend/controllers
        - backend/models
        - backend/services
        - backend/views
        - backend/tests/Functional
        - backend/tests/Unit
        - common/mail
        - common/models
        - common/widgets
        - common/tests/Unit
        - console/controllers
        - console/models

    scanDirectories:
        - backend/tests/Support
        - common/tests/Support

    bootstrapFiles:
        - phpstan-bootstrap.php

    dynamicConstantNames:
        - YII_DEBUG
        - YII_ENV
        - YII_ENV_DEV
        - YII_ENV_PROD
        - YII_ENV_TEST

    ignoreErrors:
        - '#Access to an undefined property yii\\web\\IdentityInterface::\$username.#'
        # Campos del paso a paso del area de intervencion SIN nombre (name = null) a proposito: el navegador
        # no los envia con el formulario (los lee el JS). Yii acepta null, aunque su @param dice string.
        -
            message: '#^Parameter \#1 \$name of static method yii\\helpers\\BaseHtml::(hiddenInput|textInput|dropDownList)\(\) expects string, null given\.$#'
            path: backend/views/proyecto/_form.php

    tmpDir: %currentWorkingDirectory%/runtime
