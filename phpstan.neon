# Analisis estatico (PHPStan): composer static  (o php vendor/bin/phpstan analyse)
#
# Linea base (2026-10-31):
# phpstan-baseline.neon guarda los avisos que ya existian (casi todos falsas
# alarmas de tipos, p. ej. ->all() sin "@var Modelo[]"), asi que el analisis
# solo muestra los NUEVOS. Al corregir un aviso viejo (anotando el tipo cuando
# se toca el archivo por otro motivo), PHPStan avisa que sobra en la linea
# base: regenerarla con
#   php vendor/bin/phpstan analyse --generate-baseline phpstan-baseline.neon
# No se analiza frontend/ (sitio publico de la plantilla, no se usa).

includes:
    - phpstan-baseline.neon

parameters:
    level: 5

    # Version de PHP del servidor de pruebas de la DTIC (2026-11-02).
    phpVersion: 80300

    paths:
        - backend/assets
        - backend/components
        - backend/controllers
        - backend/models
        - backend/services
        - backend/views
        - backend/tests/Functional
        - backend/tests/Unit
        - common/mail
        - common/models
        - common/widgets
        - common/tests/Unit
        - console/controllers
        - console/models

    scanDirectories:
        - backend/tests/Support
        - common/tests/Support

    bootstrapFiles:
        - phpstan-bootstrap.php

    dynamicConstantNames:
        - YII_DEBUG
        - YII_ENV
        - YII_ENV_DEV
        - YII_ENV_PROD
        - YII_ENV_TEST

    ignoreErrors:
        - '#Access to an undefined property yii\\web\\IdentityInterface::\$username.#'

    tmpDir: %currentWorkingDirectory%/runtime
