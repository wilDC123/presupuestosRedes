parameters:
	ignoreErrors:
		-
			message: '#^Variable \$masReciente on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: backend/services/EspecificacionImportacionService.php

		-
			message: '#^Access to an undefined property backend\\services\\contracts\\InfraestructuraProvider\:\:\$vigente\.$#'
			identifier: property.notFound
			count: 1
			path: backend/tests/Unit/AreaIntervencionTest.php

		-
			message: '#^Property common\\tests\\Unit\\Models\\LoginFormTest\:\:\$tester has unknown class common\\tests\\Support\\UnitTester as its type\.$#'
			identifier: class.notFound
			count: 1
			path: common/tests/Unit/Models/LoginFormTest.php
